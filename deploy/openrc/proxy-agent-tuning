#!/sbin/openrc-run
# Root DAC access writes procfs and /etc/sysctl.d; network handlers additionally
# need CAP_NET_ADMIN. DAC_OVERRIDE is needed for the Agent-owned request files.
# OpenRC has no systemd filesystem namespace protections. An ambient IAB alone
# is insufficient for UID 0: exec would regain every capability still bounded.
# Explicitly exclude every other Linux capability (0..40) from the bounding set.
name="Proxy Control whitelisted host tuning"
description="Apply the fixed sysctl whitelist published by the Agent"
supervisor="supervise-daemon"
command="/usr/local/lib/proxy-agent/tuning-watch"
command_user="root:root"
directory="/var/lib/proxy-agent"
umask=077
capabilities="^cap_net_admin,^cap_dac_override"
for tuning_cap in chown dac_read_search fowner fsetid kill setgid setuid setpcap \
  linux_immutable net_bind_service net_broadcast net_raw ipc_lock ipc_owner \
  sys_module sys_rawio sys_chroot sys_ptrace sys_pacct sys_admin sys_boot sys_nice \
  sys_resource sys_time sys_tty_config mknod lease audit_write audit_control \
  setfcap mac_override mac_admin syslog wake_alarm block_suspend audit_read \
  perfmon bpf checkpoint_restore; do
  capabilities="$capabilities,!cap_$tuning_cap"
done
no_new_privs="yes"
respawn_delay=5
respawn_max=0
output_logger="logger -t proxy-agent-tuning -p daemon.info"
error_logger="logger -t proxy-agent-tuning -p daemon.err"
start_pre() {
  # A future capability must not silently broaden a root helper's bounding set.
  read -r tuning_last_cap < /proc/sys/kernel/cap_last_cap || return 1
  case $tuning_last_cap in ''|*[!0-9]*) return 1 ;; esac
  if [ "$tuning_last_cap" -gt 40 ]; then
    eerror "Unknown Linux capability set; tuning helper stays stopped"
    return 1
  fi
}
depend() {
  need localmount
  after sysctl
  use logger
}
