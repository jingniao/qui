[Unit]
Description=Proxy Control node agent enforced outbound source
After=network-online.target
Wants=network-online.target
# Every start of this unit counts against systemd's default start rate limit (5
# starts in 10 s), whether it succeeded or not. The path unit fires this oneshot
# once per publish of desired.json, so the Agent's own retries are what bounds
# the rate; with the default limit a few quick failures stop the path unit with
# unit-start-limit-hit, and every later publish - including a clear request - is
# ignored until a reboot. StartLimitIntervalSec=0 in [Unit] disables the limit
# and is supported since systemd 230, which every supported release ships.
StartLimitIntervalSec=0

[Service]
Type=oneshot
User=proxy-agent
Group=proxy-agent
ExecStart=/usr/local/bin/proxy-agent --apply-host-network /var/lib/proxy-agent/host-network
WorkingDirectory=/var/lib/proxy-agent
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
ReadWritePaths=/var/lib/proxy-agent/host-network
CapabilityBoundingSet=CAP_NET_ADMIN
AmbientCapabilities=CAP_NET_ADMIN

[Install]
WantedBy=multi-user.target
