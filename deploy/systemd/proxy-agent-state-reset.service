[Unit]
Description=Proxy Control legacy Agent state reset
After=local-fs.target proxycontrol-update-recovery.service
# This job waits for the updater locks. Agent/helper starts must remain runnable
# while the updater validates the new worker, and while this job starts it again.
ConditionPathExists=/var/lib/proxycontrol-install/agent-state-reset/request

[Service]
Type=oneshot
ExecStart=/bin/bash /usr/local/lib/proxycontrol/agent-state-reset

[Install]
WantedBy=multi-user.target
