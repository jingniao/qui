[Unit]
Description=Proxy Control node agent
After=network-online.target proxy-agent-tuning-probe.service
Wants=network-online.target proxy-agent-tuning-probe.service

[Service]
Type=simple
User=proxy-agent
Group=proxy-agent
ExecStart=/usr/local/bin/proxy-agent --config /etc/proxy-agent/config.yaml
ExecStopPost=+/usr/local/bin/proxy-agent --finish-core-stop --config /etc/proxy-agent/config.yaml
WorkingDirectory=/var/lib/proxy-agent
StateDirectory=proxy-agent
StateDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartSec=5
TimeoutStopSec=90
KillMode=process
NoNewPrivileges=true
ProtectSystem=strict
# arm creates this directory outside the service; retain it across stops.
ReadWritePaths=-/run/proxy-agent-handover
ProtectHome=true
PrivateTmp=true
# No ProtectKernelTunables: in LXC it remounts /proc/sys and exposes the host
# boot_id instead of the container's, so core handover authorization (bound to
# the boot_id root observes) always fails. The service account has no
# capability that allows it to write sysctls.
# Keep module files readable for algorithm discovery; the syscall filter and
# capability set block explicit loading, while kernel sysctl autoload uses modprobe outside this sandbox.
SystemCallFilter=~@module
ProtectControlGroups=true
RestrictSUIDSGID=true
# Linux 5.17+ accepts SO_MARK with NET_RAW. Managed egress uses the mark to
# select the forced source without granting the agent network administration.
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_NET_RAW
AmbientCapabilities=CAP_NET_BIND_SERVICE CAP_NET_RAW

[Install]
WantedBy=multi-user.target
