{
  "log": {
    "disabled": true
  },
  "inbounds": [
    {
      "type": "socks",
      "tag": "entry",
      "listen": "127.0.0.1",
      "listen_port": 1080,
      "users": [
        {
          "username": "golden-user",
          "password": "golden-socks-secret"
        }
      ]
    }
  ],
  "outbounds": [
    {
      "type": "direct",
      "tag": "direct",
      "inet6_bind_address": "2001:db8::10",
      "domain_resolver": {
        "server": "_panel_dns_",
        "strategy": "ipv6_only"
      }
    },
    {
      "type": "http",
      "tag": "egress-primary",
      "server": "198.51.100.20",
      "server_port": 8080,
      "inet6_bind_address": "2001:db8::10",
      "domain_resolver": {
        "server": "_panel_dns_",
        "strategy": "ipv6_only"
      }
    },
    {
      "type": "trojan",
      "tag": "egress-backup",
      "server": "198.51.100.21",
      "server_port": 443,
      "password": "independent-relay-password",
      "tls": {
        "enabled": true,
        "server_name": "exit.example.test"
      },
      "inet6_bind_address": "2001:db8::10",
      "domain_resolver": {
        "server": "_panel_dns_",
        "strategy": "ipv6_only"
      }
    },
    {
      "type": "direct",
      "tag": "_panel_terminal_",
      "inet6_bind_address": "2001:db8::10",
      "domain_resolver": {
        "server": "_panel_dns_",
        "strategy": "ipv6_only"
      }
    },
    {
      "type": "urltest",
      "tag": "_panel_group_egress-pool",
      "outbounds": [
        "egress-backup",
        "egress-primary"
      ],
      "url": "https://probe.example.test/generate_204",
      "interval": "30s"
    }
  ],
  "route": {
    "rules": [
      {
        "port": [
          15402
        ],
        "action": "reject"
      },
      {
        "inbound": [
          "entry"
        ],
        "action": "route",
        "outbound": "_panel_group_egress-pool"
      }
    ],
    "final": "_panel_terminal_",
    "default_domain_resolver": "_panel_dns_"
  },
  "dns": {
    "servers": [
      {
        "type": "local",
        "tag": "_panel_dns_"
      },
      {
        "type": "hosts",
        "tag": "_panel_loopback_",
        "predefined": {
          "localhost": [
            "127.0.0.1",
            "::1"
          ]
        }
      }
    ],
    "final": "_panel_dns_"
  },
  "experimental": {
    "clash_api": {
      "external_controller": "127.0.0.1:15402",
      "secret": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
    }
  }
}