{
  "log": {
    "access": "none",
    "error": "none",
    "loglevel": "none"
  },
  "inbounds": [
    {
      "tag": "entry",
      "listen": "127.0.0.1",
      "port": 1080,
      "protocol": "dokodemo-door",
      "settings": {
        "address": "203.0.113.10",
        "followRedirect": false,
        "network": "tcp,udp",
        "port": 8443
      },
      "sniffing": {
        "enabled": true,
        "destOverride": [
          "http",
          "tls"
        ],
        "routeOnly": true
      }
    }
  ],
  "outbounds": [
    {
      "tag": "direct",
      "protocol": "freedom"
    },
    {
      "tag": "block",
      "protocol": "blackhole"
    }
  ],
  "routing": {
    "domainStrategy": "AsIs",
    "rules": [
      {
        "type": "field",
        "inboundTag": [
          "entry"
        ],
        "outboundTag": "direct",
        "ruleTag": "qui-rendered-0"
      }
    ]
  }
}
